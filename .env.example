# Devin API v3. Copy this file to .env and replace the placeholders.
# Never commit .env.
DEVIN_API_KEY=cog_REPLACE_ME
DEVIN_ORG_ID=org_REPLACE_ME
DEVIN_API_BASE=https://api.devin.ai/v3

# Optional label of a platform configured for your organization. Leave blank
# to use the organization default.
DEVIN_PLATFORM=

# Needed only for the optional account-gated paediatric SSM dataset.
SIMTK_USER=
SIMTK_PASS=
