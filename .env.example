# Devin API — copy to .env and fill in. Never commit .env.
# Key is issued as a service-user key in Settings > Service users; starts with cog_
DEVIN_API_KEY=cog_REPLACE_ME
DEVIN_ORG_ID=REPLACE_ME
DEVIN_API_BASE=https://api.devin.ai/v3

# Machine snapshot with CadQuery / gmsh / CalculiX pre-installed.
# Leave blank until the snapshot exists.
DEVIN_SNAPSHOT_ID=

# Cost guardrails.
# PLACEHOLDERS - set these to the limits the event gives us.
# For real deployment, size them against the biomedical engineer's caseload instead.
# Tracking ACU spend: https://docs.devin.ai/admin/billing/usage
DEVIN_MAX_ACU_PER_SESSION=5
DEVIN_MAX_CONCURRENT_SESSIONS=5
DEVIN_MAX_ITERATIONS=40

# SimTK credentials — needed ONLY for the paediatric dataset (paed_ssm).
# Unlike ssm_tibia (anonymous, figshare), SimTK gates its file releases behind
# a login and there is no figshare/Zenodo mirror. Registration is free and
# instant: https://simtk.org/account/register.php
SIMTK_USER=
SIMTK_PASS=
